{
  "name": "opencode-github-bot",
  "version": "0.6.0",
  "description": "OpenCode v2 GitHub bot: composite action + server plugin for PR review and issue fix",
  "type": "module",
  "main": ".opencode/plugins/github-bot/index.ts",
  "bin": {
    "opencode-github-bot": "lib/cli.js"
  },
  "files": [
    ".opencode/",
    "scripts/",
    "lib/",
    "docs/",
    "action.yml",
    "README.md"
  ],
  "dependencies": {
    "@opencode/plugin": "latest",
    "@lmnr-ai/lmnr": "0.8.55"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github",
    "pr-review",
    "issue-fix"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-seek/opencode-github-bot.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc scripts/cli.ts scripts/init.ts --outDir lib --module nodenext --target esnext --moduleResolution nodenext --skipLibCheck",
    "prepack": "npm run build",
    "init": "bun scripts/cli.ts init"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "directories": {
    "test": "tests"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/link-seek/opencode-github-bot/issues"
  },
  "homepage": "https://github.com/link-seek/opencode-github-bot#readme"
}
